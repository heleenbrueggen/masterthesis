@article{grund2018a,
  title = {Multiple {{Imputation}} of {{Missing Data}} at {{Level}} 2: {{A Comparison}} of {{Fully Conditional}} and {{Joint Modeling}} in {{Multilevel Designs}}},
  shorttitle = {Multiple {{Imputation}} of {{Missing Data}} at {{Level}} 2},
  author = {Grund, Simon and L{\"u}dtke, Oliver and Robitzsch, Alexander},
  year = {2018},
