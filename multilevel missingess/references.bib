@article{quartagno2022,
  title = {Substantive Model Compatible Multilevel Multiple Imputation: {{A}} Joint Modeling Approach},
  shorttitle = {Substantive Model Compatible Multilevel Multiple Imputation},
  author = {Quartagno, Matteo and Carpenter, James R.},
  year = {2022},
